<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:TestSuite.Common.ViewModels;assembly=TestSuite.Common"
                    xmlns:v="clr-namespace:TestSuite.UI.Views">

    <DataTemplate DataType="{x:Type vm:SetupViewModel}">
        <v:SetupView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:StatusViewModel}">
        <v:StatusView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:WelcomeViewModel}">
        <v:WelcomeView/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <v:SettingsView/>
    </DataTemplate>


    <DataTemplate DataType="{x:Type vm:MachineViewModel}">
        <v:MachineView/>
    </DataTemplate>
    
    <DataTemplate DataType="{x:Type vm:CommandViewModel}">
        <Button Command="{Binding Command}" HorizontalContentAlignment="Left" Margin="0 2">
            <StackPanel Orientation="Horizontal">
                <Border Width="32" Height="32" BorderBrush="Black" BorderThickness="0.5" Background="Orange" >
                    <TextBlock Text="{Binding IconType}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{Binding Title}" Margin="8 0 0 0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </Button.Style>
        </Button>
    </DataTemplate>

</ResourceDictionary>