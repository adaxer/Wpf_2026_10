<Window x:Class="TestSuite.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:loc="clr-namespace:TestSuite.Common;assembly=TestSuite.Common" 
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:ctrl="clr-namespace:QET.Styles.Controls;assembly=QET.Styles"
        mc:Ignorable="d"
        Title="{Binding Title}" MinHeight="520" MinWidth="800" d:DesignHeight="300" d:DesignWidth="500">

    <Window.Resources>
        <SolidColorBrush Color="AliceBlue" x:Key="StandardBackground"/>
        <Style TargetType="Button" x:Key="BackgroundButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource StandardBackground}"/>
        </Style>
    </Window.Resources>

    <!--<Window.DataContext>
        // Geht leider nicht, weil Wpf keine ctor Injection unterstützt. Daher muss der Bootstrapper die Dependencies setzen.
        <local:MainViewModel/>
    </Window.DataContext>-->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ContentControl Margin="48 0 0 0" Content="{Binding CurrentElement}"/>

        <ContentControl Content="{Binding Status}" VerticalAlignment="Bottom" Grid.Row="1" Margin="56 8 8 8" />

        <ctrl:Flyout HorizontalAlignment="Left" Grid.RowSpan="2" CollapsedWidth="32"   Padding="8" ExpandedWidth="200" Background="White" IsExpanded="{Binding IsMenuExpanded, Mode=TwoWay}"
                     ItemsSource="{Binding Commands}">
            <ctrl:Flyout.Header>
                <TextBlock Text="{x:Static loc:Strings.Navigation}" FontSize="{StaticResource StandardFontSize}" />
            </ctrl:Flyout.Header>
        </ctrl:Flyout>

        <!--<StackPanel Background="LightGreen" Width="150" HorizontalAlignment="Left" Grid.RowSpan="2">
            <Button Style="{StaticResource BackgroundButton}" Content="Load Setup" Command="{Binding LoadSetupCommand}"/>
            <Button Content="Dummy" />
            <ctrl:Gauge Value="{Binding CurrentVoltage}" FontSize="30" Margin="10"/>
        </StackPanel>-->
    </Grid>
</Window>
